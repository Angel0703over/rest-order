<view class="staff-page">
  <view class="staff-header">
    <view>
      <view class="eyebrow">员工端</view>
      <view class="title">今日订单</view>
    </view>
    <view class="pill">{{currentUser.name}}</view>
  </view>

  <view class="summary-card">
    <view>
      <view class="summary-title">待处理订单</view>
      <view class="summary-text">查看顾客位置、餐食和当前状态</view>
    </view>
    <view class="summary-count">{{orders.length}}</view>
  </view>

  <view wx:if="{{feedback}}" class="feedback">{{feedback}}</view>

  <view wx:if="{{orders.length === 0}}" class="empty-card">
    <view class="empty-title">暂无订单</view>
    <view class="empty-text">顾客提交点单后，会出现在这里。</view>
  </view>

  <view wx:else class="order-list">
    <view wx:for="{{orders}}" wx:key="id" class="order-card">
      <view class="order-head">
        <view>
          <view class="order-title">已下单</view>
          <view class="order-time">{{item.createdAt}}</view>
        </view>
        <view class="status-tag">{{item.status}}</view>
      </view>

      <view class="location-box">
        <view class="location-label">送达位置</view>
        <view class="location-text">{{item.locationText}}</view>
      </view>

      <view class="order-line">
        <text>餐食</text>
        <text>{{item.mealName}}</text>
      </view>
      <view class="order-line">
        <text>会员</text>
        <text>{{item.memberName}} · {{item.memberLevelName}}</text>
      </view>

      <picker mode="selector" range="{{statusOptions}}" bindchange="onStatusChange" data-id="{{item.id}}">
        <view class="status-picker">更新状态</view>
      </picker>
    </view>
  </view>
</view>
