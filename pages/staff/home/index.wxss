.staff-page {
  background: #f7eee8;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 30rpx 24rpx 56rpx;
}

.staff-header {
  align-items: flex-start;
  display: flex;
  gap: 18rpx;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.eyebrow {
  color: #9a6b57;
  font-size: 22rpx;
  line-height: 1.25;
  margin-bottom: 6rpx;
}

.title {
  color: #2f2520;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.18;
}

.pill {
  border: 1rpx solid rgba(108, 77, 63, 0.22);
  border-radius: 999rpx;
  color: #7a4f3e;
  flex: 0 0 auto;
  font-size: 22rpx;
  padding: 8rpx 15rpx;
}

.summary-card {
  align-items: center;
  background: #2f2520;
  border-radius: 14rpx;
  color: #fff8f2;
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 22rpx;
}

.summary-title {
  font-size: 31rpx;
  font-weight: 700;
}

.summary-text {
  color: rgba(255, 248, 242, 0.72);
  font-size: 22rpx;
  margin-top: 8rpx;
}

.summary-count {
  align-items: center;
  background: rgba(255, 248, 242, 0.12);
  border-radius: 999rpx;
  display: flex;
  flex: 0 0 auto;
  font-size: 34rpx;
  font-weight: 700;
  height: 72rpx;
  justify-content: center;
  margin-left: 18rpx;
  width: 72rpx;
}

.feedback,
.empty-card,
.order-card {
  background: #fffaf6;
  border: 1rpx solid rgba(120, 82, 66, 0.1);
  border-radius: 14rpx;
  padding: 18rpx;
}

.feedback {
  color: #7a4f3e;
  font-size: 24rpx;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.empty-title {
  color: #2f2520;
  font-size: 29rpx;
  font-weight: 700;
}

.empty-text {
  color: #8b7469;
  font-size: 23rpx;
  margin-top: 8rpx;
}

.order-list {
  display: grid;
  gap: 14rpx;
}

.order-head,
.order-line {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.order-title {
  color: #2f2520;
  font-size: 30rpx;
  font-weight: 700;
}

.order-time {
  color: #8b7469;
  font-size: 22rpx;
  margin-top: 5rpx;
}

.status-tag {
  background: #f0e4dc;
  border-radius: 999rpx;
  color: #7a4f3e;
  font-size: 21rpx;
  font-weight: 700;
  padding: 8rpx 12rpx;
}

.location-box {
  background: #f7eee8;
  border-radius: 12rpx;
  margin-top: 16rpx;
  padding: 16rpx;
}

.location-label {
  color: #8b7469;
  font-size: 21rpx;
}

.location-text {
  color: #2f2520;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
  margin-top: 6rpx;
}

.order-line {
  color: #6b554d;
  font-size: 24rpx;
  gap: 18rpx;
  margin-top: 14rpx;
}

.order-line text:last-child {
  color: #2f2520;
  flex: 1;
  font-weight: 700;
  text-align: right;
}

.status-picker {
  background: #2f2520;
  border-radius: 12rpx;
  color: #fff8f2;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 72rpx;
  margin-top: 18rpx;
  text-align: center;
}
