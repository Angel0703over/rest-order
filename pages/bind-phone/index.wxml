<view class="bind-page">
  <view class="topbar">会员休息点单</view>

  <view class="hero">
    <view class="eyebrow">扫码进入</view>
    <view class="title">绑定手机号</view>
    <view class="subtitle">使用微信手机号匹配门店身份：会员绑定后按等级点单，员工绑定后进入员工端。</view>
  </view>

  <view class="panel">
    <view class="section-title">身份验证</view>
    <view class="info-row">
      <view class="info-label">匹配方式</view>
      <view class="info-value">微信手机号授权</view>
    </view>
    <view class="info-row">
      <view class="info-label">身份来源</view>
      <view class="info-value">员工名单优先，其次会员表</view>
    </view>
    <button
      class="bind-button"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      loading="{{binding}}"
      disabled="{{binding}}"
    >
      {{binding ? '正在绑定...' : '授权手机号并绑定'}}
    </button>
    <view wx:if="{{feedback}}" class="feedback">{{feedback}}</view>
  </view>
</view>
