page {
  background: #f7eee8;
  color: #2f2520;
}

.bind-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 22rpx 42rpx;
}

.topbar {
  font-size: 28rpx;
  text-align: center;
}

.hero {
  padding: 58rpx 0 28rpx;
}

.eyebrow {
  color: #9a6f5d;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.title {
  color: #2f2520;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
}

.subtitle {
  color: #8b7469;
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 18rpx;
}

.panel {
  background: #fffaf6;
  border: 1rpx solid rgba(120, 82, 66, 0.1);
  border-radius: 14rpx;
  box-sizing: border-box;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 18rpx;
}

.info-row {
  align-items: center;
  border-bottom: 1rpx solid rgba(120, 82, 66, 0.08);
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
}

.info-label {
  color: #8b7469;
  font-size: 24rpx;
}

.info-value {
  color: #2f2520;
  font-size: 25rpx;
  font-weight: 700;
}

.bind-button {
  background: #2f2520;
  border-radius: 12rpx;
  color: #fffaf6;
  font-size: 28rpx;
  font-weight: 800;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 28rpx;
}

.feedback {
  background: #fff1c8;
  border-radius: 10rpx;
  color: #7a4f3e;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 18rpx;
  padding: 16rpx;
}
