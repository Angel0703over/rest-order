<view class="page">
  <view class="header">
    <view>
      <view class="eyebrow">顾客订单</view>
      <view class="title">我的订单</view>
    </view>
    <view class="pill">{{orders.length}} 单</view>
  </view>

  <view wx:if="{{feedback}}" class="empty-card">
    <view class="empty-title">{{feedback}}</view>
  </view>

  <view wx:if="{{orders.length === 0}}" class="empty-card">
    <view class="empty-title">还没有订单</view>
    <view class="empty-text">在点单页选择餐食后，订单会显示在这里。</view>
  </view>

  <view wx:else class="order-list">
    <view wx:for="{{orders}}" wx:key="id" class="order-card">
      <view class="order-head">
        <view class="order-id">已下单</view>
        <view class="status">{{item.status}}</view>
      </view>
      <view class="line">
        <text>餐食</text>
        <text>{{item.mealName}}</text>
      </view>
      <view class="line">
        <text>位置</text>
        <text>{{item.locationText}}</text>
      </view>
      <view class="line">
        <text>时间</text>
        <text>{{item.createdAt}}</text>
      </view>
    </view>
  </view>
</view>
