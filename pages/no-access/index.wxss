.page {
  align-items: center;
  background: #f7eee8;
  box-sizing: border-box;
  display: flex;
  min-height: 100vh;
  padding: 40rpx;
}

.card {
  background: #fffaf6;
  border: 1rpx solid rgba(120, 82, 66, 0.1);
  border-radius: 18rpx;
  box-sizing: border-box;
  padding: 44rpx 34rpx;
  text-align: center;
  width: 100%;
}

.mark {
  align-items: center;
  background: #2f2520;
  border-radius: 50%;
  color: #fff8f2;
  display: flex;
  font-size: 44rpx;
  font-weight: 700;
  height: 88rpx;
  justify-content: center;
  margin: 0 auto 24rpx;
  width: 88rpx;
}

.title {
  color: #2f2520;
  font-size: 40rpx;
  font-weight: 700;
}

.message {
  color: #8b7469;
  font-size: 26rpx;
  line-height: 1.55;
  margin: 18rpx 0 30rpx;
}

.primary,
.secondary {
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 84rpx;
  margin-top: 16rpx;
}

.primary {
  background: #2f2520;
  color: #fff8f2;
}

.secondary {
  background: #f0e4dc;
  color: #6b554d;
}

.primary::after,
.secondary::after {
  border: 0;
}
