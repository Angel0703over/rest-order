.admin-page {
  background: #f7eee8;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 30rpx 24rpx 56rpx;
}

.admin-header {
  align-items: flex-start;
  display: flex;
  gap: 18rpx;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.eyebrow {
  color: #9a6b57;
  font-size: 22rpx;
  line-height: 1.25;
  margin-bottom: 6rpx;
}

.title {
  color: #2f2520;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.18;
}

.pill {
  border: 1rpx solid rgba(108, 77, 63, 0.22);
  border-radius: 999rpx;
  color: #7a4f3e;
  flex: 0 0 auto;
  font-size: 22rpx;
  padding: 8rpx 15rpx;
}

.panel {
  background: #fffaf6;
  border: 1rpx solid rgba(120, 82, 66, 0.1);
  border-radius: 14rpx;
  padding: 16rpx;
}

.section-title {
  color: #302723;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
}

.section-subtitle,
.hint {
  color: #8b7469;
  font-size: 22rpx;
  line-height: 1.42;
}

.primary-button,
.secondary-button,
.delete-button,
.save-button,
.create-button,
.switch-admin,
.upload-button {
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 64rpx;
  margin: 0;
  min-width: 0;
  overflow: hidden;
  padding: 0 18rpx;
  width: 100%;
}

.primary-button,
.save-button {
  background: #2f2520;
  color: #fff8f2;
}

.secondary-button,
.create-button,
.switch-admin,
.upload-button {
  background: #fffaf6;
  border: 1rpx solid rgba(120, 82, 66, 0.12);
  color: #7a4f3e;
}

.delete-button {
  background: #f0e4dc;
  color: #6b554d;
}

.create-button::after,
.delete-button::after,
.save-button::after,
.switch-admin::after,
.upload-button::after,
.primary-button::after,
.secondary-button::after {
  border: 0;
}

.field {
  margin-top: 16rpx;
}

.label {
  color: #6b554d;
  font-size: 23rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.input,
.textarea,
.picker-value {
  background: #f7eee8;
  border-radius: 10rpx;
  box-sizing: border-box;
  color: #2f2520;
  font-size: 26rpx;
  line-height: 1.35;
  min-height: 68rpx;
  padding: 14rpx 16rpx;
  width: 100%;
}

.textarea {
  height: 128rpx;
  min-height: 128rpx;
}

.feedback {
  background: #fff3cf;
  border-radius: 10rpx;
  color: #7a4f3e;
  font-size: 24rpx;
  line-height: 1.4;
  margin-top: 16rpx;
  padding: 14rpx;
}

.actions {
  display: grid;
  gap: 12rpx;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  margin-top: 20rpx;
  width: 100%;
}

.actions button {
  box-sizing: border-box;
  min-width: 0;
  width: 100%;
}

.status-tag {
  background: #f0e4dc;
  border-radius: 999rpx;
  color: #7a4f3e;
  display: inline-flex;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1;
  padding: 8rpx 12rpx;
}

.status-tag-dark {
  background: #2f2520;
  color: #fff8f2;
}

.status-tag-muted {
  background: #d6c7bf;
  color: #6b554d;
}
