@import "../common.wxss";

.create-button {
  margin-bottom: 16rpx;
}

.category-list {
  background: #fffaf6;
  border: 1rpx solid rgba(120, 82, 66, 0.1);
  border-radius: 14rpx;
  display: grid;
  gap: 10rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-bottom: 16rpx;
  padding: 14rpx;
}

.category-row {
  border: 1rpx solid rgba(120, 82, 66, 0.08);
  border-radius: 12rpx;
  padding: 15rpx;
}

.category-row-active {
  background: #f4e9e1;
  border-color: #a86a50;
}

.category-name {
  color: #2f2520;
  font-size: 28rpx;
  font-weight: 700;
}

.category-id {
  color: #8b7469;
  font-size: 21rpx;
  margin-top: 5rpx;
}
