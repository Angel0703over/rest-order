<view class="admin-page">
  <view class="admin-header">
    <view>
      <view class="eyebrow">店长配置</view>
      <view class="title">员工管理</view>
    </view>
    <view class="pill">{{staffMembers.length}} 人</view>
  </view>

  <button class="create-button" bindtap="onCreateStaff" disabled="{{loading}}">新增店员</button>

  <view class="staff-list">
    <view
      wx:for="{{staffMembers}}"
      wx:key="id"
      class="staff-row {{selectedStaffId === item.id ? 'staff-row-active' : ''}}"
      bindtap="onSelectStaff"
      data-id="{{item.id}}"
    >
      <view>
        <view class="staff-name">{{item.name}}</view>
        <view class="staff-meta">{{item.title}} · {{item.phone}}</view>
      </view>
      <view class="status-tag {{item.role === 'owner' ? 'status-tag-dark' : (item.active ? '' : 'status-tag-muted')}}">
        {{item.role === 'owner' ? '店长' : (item.active ? '启用' : '停用')}}
      </view>
    </view>
  </view>

  <view class="editor panel">
    <view class="section-title">编辑员工</view>
    <view class="field">
      <view class="label">姓名</view>
      <input class="input" value="{{draft.name}}" bindinput="onNameInput" disabled="{{draft.role === 'owner'}}" placeholder="请输入员工姓名" />
    </view>
    <view class="field">
      <view class="label">手机号</view>
      <input class="input" value="{{draft.phone}}" bindinput="onPhoneInput" disabled="{{draft.role === 'owner'}}" placeholder="请输入员工手机号" />
    </view>
    <view class="field">
      <view class="label">岗位</view>
      <input class="input" value="{{draft.title}}" bindinput="onTitleInput" disabled="{{draft.role === 'owner'}}" placeholder="例如：美睫师" />
    </view>
    <view class="switch-row">
      <view>
        <view class="label">账号状态</view>
        <view class="hint">停用后该店员不能进入后台</view>
      </view>
      <switch checked="{{draft.active}}" disabled="{{draft.role === 'owner'}}" bindchange="onActiveChange" />
    </view>

    <view wx:if="{{loading}}" class="feedback">正在同步云端员工...</view>
    <view wx:elif="{{feedback}}" class="feedback">{{feedback}}</view>
    <view class="actions">
      <button class="delete-button" bindtap="onDeleteStaff" disabled="{{draft.role === 'owner' || loading}}">停用</button>
      <button class="save-button" bindtap="onSaveStaff" disabled="{{draft.role === 'owner' || loading}}">保存</button>
    </view>
  </view>
</view>
