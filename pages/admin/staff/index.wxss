@import "../common.wxss";

.create-button {
  margin-bottom: 16rpx;
}

.staff-list {
  background: #fffaf6;
  border: 1rpx solid rgba(120, 82, 66, 0.1);
  border-radius: 14rpx;
  display: grid;
  gap: 10rpx;
  margin-bottom: 16rpx;
  padding: 14rpx;
}

.staff-row {
  align-items: center;
  border: 1rpx solid rgba(120, 82, 66, 0.08);
  border-radius: 12rpx;
  display: flex;
  gap: 14rpx;
  justify-content: space-between;
  padding: 15rpx;
}

.staff-row-active {
  background: #f4e9e1;
  border-color: #a86a50;
}

.staff-name {
  color: #2f2520;
  font-size: 28rpx;
  font-weight: 700;
}

.staff-meta {
  color: #8b7469;
  font-size: 22rpx;
  margin-top: 5rpx;
}

.switch-row {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
}
