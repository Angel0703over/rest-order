@import "../common.wxss";

.settings-grid {
  display: grid;
  gap: 16rpx;
  margin-top: 16rpx;
}

.room-list {
  display: grid;
  gap: 10rpx;
}

.room-row {
  align-items: center;
  border: 1rpx solid rgba(120, 82, 66, 0.08);
  border-radius: 12rpx;
  display: flex;
  gap: 14rpx;
  justify-content: space-between;
  padding: 15rpx;
}

.room-row-active {
  background: #f4e9e1;
  border-color: #a86a50;
}

.room-name {
  color: #2f2520;
  font-size: 27rpx;
  font-weight: 700;
}

.room-meta {
  color: #8b7469;
  font-size: 22rpx;
  margin-top: 5rpx;
}

.switch-row {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
}

.save-wide {
  margin-top: 18rpx;
}
