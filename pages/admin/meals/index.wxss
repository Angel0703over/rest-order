@import "../common.wxss";

.switch-admin {
  margin-bottom: 16rpx;
}

.meal-list {
  background: #fffaf6;
  border: 1rpx solid rgba(120, 82, 66, 0.1);
  border-radius: 14rpx;
  display: grid;
  gap: 10rpx;
  margin-bottom: 16rpx;
  padding: 14rpx;
}

.meal-row {
  align-items: center;
  border: 1rpx solid rgba(120, 82, 66, 0.08);
  border-radius: 12rpx;
  display: flex;
  gap: 12rpx;
  padding: 14rpx;
}

.meal-row-active {
  background: #f4e9e1;
  border-color: #a86a50;
}

.meal-image,
.preview-image {
  background: #eadbd1;
  border-radius: 10rpx;
  flex: 0 0 auto;
  height: 82rpx;
  width: 82rpx;
}

.meal-main {
  flex: 1;
  min-width: 0;
}

.meal-name {
  color: #2f2520;
  font-size: 28rpx;
  font-weight: 700;
}

.meal-note {
  color: #8b7469;
  font-size: 21rpx;
  line-height: 1.35;
  margin-top: 5rpx;
}

.meal-tags {
  align-items: flex-end;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 7rpx;
}

.stock-on {
  background: #e4efe2;
  color: #4c7a48;
}

.image-row {
  align-items: stretch;
  display: grid;
  gap: 12rpx;
  grid-template-columns: 82rpx minmax(0, 1fr);
}

.image-status {
  align-items: flex-start;
  background: #f4ece7;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  padding: 12rpx 16rpx;
}

.image-status-title {
  color: #2f2520;
  font-size: 26rpx;
  font-weight: 700;
}

.upload-button {
  margin-top: 12rpx;
}

.switch-field {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.save-button {
  margin-top: 20rpx;
}
