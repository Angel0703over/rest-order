@import "../common.wxss";

.switch-admin {
  margin-bottom: 16rpx;
}

.level-list {
  background: #fffaf6;
  border: 1rpx solid rgba(120, 82, 66, 0.1);
  border-radius: 14rpx;
  display: grid;
  gap: 10rpx;
  margin-bottom: 16rpx;
  padding: 14rpx;
}

.level-row {
  align-items: center;
  border: 1rpx solid rgba(120, 82, 66, 0.08);
  border-radius: 12rpx;
  display: flex;
  gap: 14rpx;
  padding: 15rpx;
}

.level-row-active {
  background: #f4e9e1;
  border-color: #a86a50;
}

.level-swatch,
.preview {
  border-radius: 50%;
  flex: 0 0 auto;
  height: 38rpx;
  width: 38rpx;
}

.level-main {
  flex: 1;
  min-width: 0;
}

.level-name {
  color: #2f2520;
  font-size: 28rpx;
  font-weight: 700;
}

.level-note {
  color: #8b7469;
  font-size: 22rpx;
  line-height: 1.35;
  margin-top: 5rpx;
}

.level-rank {
  color: #7a4f3e;
  flex: 0 0 auto;
  font-size: 23rpx;
  font-weight: 700;
}

.color-row {
  align-items: center;
  display: flex;
  gap: 12rpx;
}

.color-input {
  flex: 1;
}

.save-button {
  margin-top: 20rpx;
}
